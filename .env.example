# ============================================================
# VyasaPrep / SmartKCET Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Supabase Cloud PostgreSQL connection string (pooler URL).
# Format: postgresql+psycopg2://<user>:<password>@<host>:5432/postgres
DATABASE_URL=

# ── Admin account ────────────────────────────────────────────
# Email used to log in as platform admin.
ADMIN_EMAIL=

# Bcrypt hash of the admin password.
# Generate with: python generate_admin_hash.py
ADMIN_PASSWORD_HASH=

# Display name shown in the admin UI.
ADMIN_DISPLAY_NAME=Administrator

# ── JWT / Auth ───────────────────────────────────────────────
# Random secret for signing JWTs. Must be at least 16 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── AI / LLM ─────────────────────────────────────────────────
# Groq API key for LLM question generation and analysis.
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Set to a vision-enabled model ID available to this Groq API key.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: override the default Groq model.
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase Storage ─────────────────────────────────────────
# Your Supabase project URL.
SUPABASE_URL=

# Supabase service role secret key (from Project Settings → API).
# WARNING: this key has full DB access — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (defaults shown; change only if you renamed them).
SUPABASE_FAISS_BUCKET=vyasaprep-faiss
SUPABASE_TEXTBOOKS_BUCKET=vyasaprep-textbooks

# ── Payments (Razorpay) ──────────────────────────────────────
# Leave empty in dev — the app will use mock orders automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to 1 to skip real payment processing (useful in staging).
SMARTKCET_MOCK_PAYMENTS=0

# ── Application ──────────────────────────────────────────────
# Set to 1 to enable dev-mode relaxed auth and mock payments.
# MUST be 0 in production.
SMARTKCET_DEV_MODE=0

# Host and port for local development only (ignored on Vercel/Railway).
SMARTKCET_HOST=127.0.0.1
SMARTKCET_PORT=8000
